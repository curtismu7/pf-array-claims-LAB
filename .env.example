# Real mode (all optional; Mock is the default and needs nothing).
# Copy to .env beside docker-compose.yml, or put the same keys in ~/Development/.env (the shared file).
# The gateway is the Privilege agent gateway; PAC_GW_KEY_<NAME> is an agent access key (write-only: never logged).
# PAC_GW_URL=https://mcpgw.example.com
# PAC_GW_APPS=aggregate-limited
# PAC_GW_VERSION=v1
# PAC_GW_KEY_LAB_AGENT=sk-orion-...
